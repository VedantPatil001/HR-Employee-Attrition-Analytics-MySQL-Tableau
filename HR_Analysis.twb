            <column-instance column='[Calculation_3078952443994112]' derivation='User' name='[cum:usr:Calculation_3078952443994112:qk]' pivot='key' type='quantitative'>
              <table-calc aggregation='Sum' ordering-type='Rows' type='CumTotal' />
